\def\@LN@column{1}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.5}GSE7621 reveals candidate PD-divergent synuclein--mitochondrial remodeling}{6}{subsection.2.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Cross-cohort evidence map.} Heatmap values summarize locked endpoint effects for selected axes across AD and PD cohorts. Negative values indicate lower axis scores in endpoint-positive samples. The strongest coherent AD-replicated pattern is neuronal vulnerability; the strongest statistically supported PD-specific result is the opposite-direction GSE7621 synuclein--mitochondrial axis.}}{6}{figure.caption.4}\protected@file@percent }
\newlabel{fig:evidencemap}{{2}{6}{\textbf {Cross-cohort evidence map.} Heatmap values summarize locked endpoint effects for selected axes across AD and PD cohorts. Negative values indicate lower axis scores in endpoint-positive samples. The strongest coherent AD-replicated pattern is neuronal vulnerability; the strongest statistically supported PD-specific result is the opposite-direction GSE7621 synuclein--mitochondrial axis}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Focused AD replication and PD divergence.} The neuronal vulnerability axis is FDR-supported in SEA-AD and nominally replicated in GSE174367 but remains non-significant in GSE20141 and GSE7621. The synuclein--mitochondrial axis shows statistically supported opposite-direction evidence in GSE7621, motivating a candidate PD-divergent interpretation rather than a shared-axis claim.}}{7}{figure.caption.5}\protected@file@percent }
\newlabel{fig:axisfocus}{{3}{7}{\textbf {Focused AD replication and PD divergence.} The neuronal vulnerability axis is FDR-supported in SEA-AD and nominally replicated in GSE174367 but remains non-significant in GSE20141 and GSE7621. The synuclein--mitochondrial axis shows statistically supported opposite-direction evidence in GSE7621, motivating a candidate PD-divergent interpretation rather than a shared-axis claim}{figure.caption.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Conservative cross-cohort evidence summary for key NeuroFate axes.}}{7}{table.caption.6}\protected@file@percent }
\newlabel{tab:evidence}{{3}{7}{Conservative cross-cohort evidence summary for key NeuroFate axes}{table.caption.6}{}}
